{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-to-gate.local/schemas/policy.schema.json",
  "title": "CTG Policy",
  "description": "Policy configuration for code-to-gate release readiness evaluation",
  "type": "object",
  "required": ["version", "policy_id", "blocking", "confidence"],
  "additionalProperties": false,
  "not": { "required": ["severity_overrides", "severityOverrides"] },
  "$defs": {
    "severityOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "reason"],
      "anyOf": [
        { "required": ["rule_id"] },
        { "required": ["ruleId"] },
        { "required": ["path"] },
        { "required": ["category"] }
      ],
      "not": { "required": ["rule_id", "ruleId"] },
      "properties": {
        "rule_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "ruleId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "pattern": "^(?!\\s)(?!.*\\s$)(?!!).+$" },
        "category": { "enum": ["auth", "payment", "validation", "data", "config", "maintainability", "testing", "compatibility", "release-risk", "security"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "const": "ctg/v1",
      "description": "Policy schema version"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique policy identifier"
    },
    "description": {
      "type": "string",
      "description": "Policy description"
    },
    "blocking": {
      "type": "object",
      "required": ["severity", "category"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "object",
          "description": "Severity blocking thresholds",
          "properties": {
            "critical": { "type": "boolean" },
            "high": { "type": "boolean" },
            "medium": { "type": "boolean" },
            "low": { "type": "boolean" }
          }
        },
        "category": {
          "type": "object",
          "description": "Category blocking thresholds",
          "properties": {
            "auth": { "type": "boolean" },
            "payment": { "type": "boolean" },
            "validation": { "type": "boolean" },
            "data": { "type": "boolean" },
            "config": { "type": "boolean" },
            "maintainability": { "type": "boolean" },
            "testing": { "type": "boolean" },
            "compatibility": { "type": "boolean" },
            "release-risk": { "type": "boolean" },
            "security": { "type": "boolean" }
          }
        },
        "rules": {
          "type": "object",
          "description": "Rule-specific blocking thresholds",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "count_threshold": {
          "type": "object",
          "description": "Count thresholds for findings",
          "properties": {
            "critical_max": { "type": "integer", "minimum": 0 },
            "high_max": { "type": "integer", "minimum": 0 },
            "medium_max": { "type": "integer", "minimum": 0 },
            "low_max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["min_confidence"],
      "additionalProperties": false,
      "properties": {
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence threshold for findings"
        },
        "low_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Threshold for flagging low confidence findings"
        },
        "filter_low": {
          "type": "boolean",
          "description": "Filter out low confidence findings"
        }
      }
    },
    "suppression": {
      "type": "object",
      "description": "Suppression configuration",
      "properties": {
        "file": { "type": "string" },
        "expiry_warning_days": { "type": "integer", "minimum": 0 },
        "max_suppressions_per_rule": { "type": "integer", "minimum": 0 }
      }
    },
    "llm": {
      "type": "object",
      "description": "LLM policy configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["remote", "local-only", "none"] },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "require_llm": { "type": "boolean" },
        "unsupported_claims_max": { "type": "integer", "minimum": 0 }
      }
    },
    "partial": {
      "type": "object",
      "description": "Partial artifact handling",
      "properties": {
        "allow_partial": { "type": "boolean" },
        "partial_warning_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "baseline": {
      "type": "object",
      "description": "Baseline comparison configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "file": { "type": "string" },
        "new_findings_block": { "type": "boolean" }
      }
    },
    "exit": {
      "type": "object",
      "description": "Exit code policy",
      "properties": {
        "fail_on_critical": { "type": "boolean" },
        "fail_on_high": { "type": "boolean" },
        "warn_only": { "type": "boolean" }
      }
    },
    "rule_options": {
      "type": "object",
      "description": "Rule-specific analysis thresholds",
      "additionalProperties": false,
      "properties": {
        "LARGE_MODULE": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_lines": { "type": "integer", "minimum": 0 },
            "max_functions": { "type": "integer", "minimum": 0 },
            "max_size_kb": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "dsl": {
      "type": "object",
      "description": "Context-aware Policy DSL rules",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when", "action"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "when": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "severity": { "enum": ["critical", "high", "medium", "low"] },
                  "category": {
                    "enum": [
                      "auth",
                      "payment",
                      "validation",
                      "data",
                      "config",
                      "maintainability",
                      "testing",
                      "compatibility",
                      "release-risk",
                      "security"
                    ]
                  },
                  "rule_id": { "type": "string", "minLength": 1 },
                  "baseline": { "enum": ["new_or_worsened"] },
                  "manual_evidence": { "enum": ["present", "absent"] }
                }
              },
              "action": { "enum": ["block", "hold", "allow"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "severity_overrides": {
      "type": "array",
      "description": "Ordered severity overrides; the first matching entry wins",
      "items": { "$ref": "#/$defs/severityOverride" }
    },
    "severityOverrides": {
      "type": "array",
      "description": "Camel case alias for severity_overrides",
      "items": { "$ref": "#/$defs/severityOverride" }
    }
  }
}
